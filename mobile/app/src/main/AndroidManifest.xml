<?xml version="1.0" encoding="utf-8"?>
<!--
  Porten 宿主壳清单。

  安全基线说明：
    - allowBackup=false：禁止系统备份与应用数据导出，避免聊天记录/身份信息落地到云端或 PC；
    - usesCleartextTraffic=false：禁止明文 HTTP 通信，全部走 TLS（证书绑定在 :core:security）；
    - FLAG_SECURE 在关键页面另外动态设置（列表页/聊天页由 :core:security 提供遮罩能力）；
    - 权限按最小够用原则声明，运行时权限由 :feature:* 在真正使用时申请。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：IM 长连接与 API 通信必需 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 网络状态变化监听：用于长连接在网络切换时快速重连 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:name=".PortenApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Porten"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Porten.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
