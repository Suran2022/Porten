# 前端环境变量配置示例
# 复制本文件为 .env 并填入真实值后再启动

# API 基础路径（开发环境通过 vite proxy 代理，无需填写完整地址）
VITE_API_BASE_URL=/api/v1

# WebSocket 地址（用于实时消息推送）
# 本地开发：ws://localhost:8000/ws
# 生产环境：wss://your-domain.com/ws
VITE_API_WS_URL=ws://localhost:8000/ws

# Mock 模式（默认开启）：使用本地 mock 数据运行，登录可用任意账号直接进入；
# 联调真实后端时设置为 false
VITE_USE_MOCK=true

