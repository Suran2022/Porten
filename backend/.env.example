# ============================================
# Porten Backend 环境变量配置示例
# 复制本文件为 .env 并填入真实值后再启动
# ============================================

# Database (MySQL 8.0+)
# 本地开发：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/porten?charset=utf8mb4

# Security
# 生产环境务必替换为随机字符串（至少 32 字符），可用：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SMTP 邮件服务（用于发送验证码）
# 以 QQ 邮箱为例：开启 SMTP 服务后获取授权码（非登录密码）
# 其他邮箱（Gmail/163 等）请相应修改 host/port
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_SENDER_NAME=Porten

# Application
DEFAULT_AVATAR_URL=https://example.com/default-avatar.png
APP_NAME=Porten
APP_ENV=development

# Application timezone (display zone for all user-facing datetimes)
APP_TIMEZONE=Asia/Shanghai

# Weather provider (trip reminder weather sentences)
# Both values must be set to enable the HTTP provider; otherwise the
# weather part is omitted from reminders. URL template supports {city}
# and {key} placeholders; response paths are dotted (e.g. now.text).
WEATHER_URL_TEMPLATE=
WEATHER_API_KEY=
WEATHER_TEXT_PATH=now.text
WEATHER_TEMP_PATH=now.temp
WEATHER_TIMEOUT_SECONDS=5.0
# Destination is "colder" when at least this many degrees below origin
WEATHER_TEMP_DROP_THRESHOLD=3.0

# Trip reminder sentence templates (placeholders in braces)
TRIP_REMINDER_DAYS_TEMPLATE=还有{days}天飞往{arrival_city}
TRIP_REMINDER_HOURS_TEMPLATE=还有{hours}小时飞往{arrival_city}
TRIP_REMINDER_WEATHER_TEMPLATE=您当前所在城市天气{origin_text}，{arrival_city}{arrival_text}，气温{origin_temp}℃/{arrival_temp}℃
TRIP_REMINDER_WEATHER_COOL_TEMPLATE=您当前所在城市天气{origin_text}，但{arrival_city}气温较低，注意保暖哦！
